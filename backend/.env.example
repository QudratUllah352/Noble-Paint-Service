# Copy this file to backend/.env and fill in your own values.
# Never commit .env or share real credentials.

# --- Server ---
NODE_ENV=development
PORT=5000
# Must match the exact address you open in the browser, including the port.
PUBLIC_SITE_URL=http://localhost:5000

# --- Database (required) ---
MONGODB_URI=mongodb://127.0.0.1:27017/noble-paint-service

# --- Admin login ---
# Required for the admin area. Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Used once by scripts/createAdmin.js to create the first admin account.
# Remove ADMIN_PASSWORD from .env after the account is created.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email (optional) ---
# Leave disabled until your SMTP provider's settings are ready.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
BUSINESS_NOTIFICATION_EMAIL=
